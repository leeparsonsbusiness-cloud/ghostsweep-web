{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "buildCommand": "npm --prefix website run build",
  "installCommand": "npm --prefix website install",
  "outputDirectory": "website/.next",
  "crons": [
    {
      "path": "/api/cron/radar-sweep",
      "schedule": "0 0 * * *"
    }
  ]
}
